# Copy the variable names into your shell or local secret manager.
# Spring Boot does not load this file automatically.

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=RestaurantManagementDB;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_sql_server_username
DB_PASSWORD=your_sql_server_password
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

MAIL_USERNAME=your_email_address
MAIL_PASSWORD=your_email_app_password

PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false
